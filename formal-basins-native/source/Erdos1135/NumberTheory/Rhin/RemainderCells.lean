/-- A compact computable condition that a nonempty cell list is contiguous
with the stated outer endpoints. -/
def rhinCellChain (a b : ℚ) : List RhinCell → Prop
  | [] => False
  | c :: cs =>
      c.left = a ∧ c.left < c.right ∧
        match cs with
        | [] => c.right = b
        | _ => rhinCellChain c.right b cs

