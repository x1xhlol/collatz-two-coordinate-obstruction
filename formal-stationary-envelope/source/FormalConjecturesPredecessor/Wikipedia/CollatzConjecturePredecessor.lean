import Mathlib.Algebra.Ring.Parity
import Mathlib.Logic.Function.Iterate

namespace CollatzConjecturePredecessor

def collatzStep (n : Nat) : Nat :=
  if Even n then n / 2 else 3 * n + 1

end CollatzConjecturePredecessor
